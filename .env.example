# JWT Secret for authentication (required in production)
JWT_SECRET=your_super_secret_key_here

# Database path (optional; defaults to /tmp/db.sqlite on Render free, ./data/finance.db locally)
# For Render free plan, leave as default or set to /tmp/db.sqlite
# For persistent storage, use Render Starter plan disk: /mnt/data/db.sqlite
DB_PATH=/tmp/db.sqlite

# Node environment (optional; defaults to 'production' on Render)
NODE_ENV=production

# Port (optional; Render/Railway set this automatically, defaults to 4000)
# PORT=4000

# Database for testing (auto-set in test script)
# NODE_ENV=test (run via `npm test`)
